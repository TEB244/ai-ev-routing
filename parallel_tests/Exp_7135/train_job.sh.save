#!/bin/bash
#SBATCH --job-name=Exp_7135_train_saveAgg_evalEp1
#SBATCH --output=experiments/Exp_7135/output_saveAgg_evalEp1.log
#SBATCH --error=experiments/Exp_7135/error_saveAgg_evalEp1.log
#SBATCH -A  def_mcapretz
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=3:00:00
#SBATCH --mem=64G
#SBATCH --gpus-per-node=1

#SBATCH --mail-type=FAIL,TIME_LIMIT
#SBATCH --mail-user=epigou@uwo.ca

echo "Starting training for experiment 7135"

set -e  # Exit immediately if a command exits with a non-zero status

module load python/3.10 cuda cudnn
source ~/envs/merl_env/bin/activate

# Enable multi-threading
export OMP_NUM_THREADS=4



python main.py -g 0 -e 7135 -d "/home/epigou/scratch/metrics/Exp"
